<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.dynamic-notch.NotchStyle">
    <value nick="apple" value="0"/>
    <value nick="pill" value="1"/>
  </enum>
  <enum id="org.gnome.shell.extensions.dynamic-notch.Position">
    <value nick="top" value="0"/>
    <value nick="bottom" value="1"/>
    <value nick="left" value="2"/>
    <value nick="right" value="3"/>
  </enum>
  <!-- BARU (refinement v2): mode background panel. Mode kelima "dynamic"
       TIDAK dimasukkan ke enum ini — perilaku dynamic tetap dipegang
       key bawaan transparent-panel di bawah, supaya tidak ada dua
       sumber kebenaran untuk perilaku yang sama. -->
  <enum id="org.gnome.shell.extensions.dynamic-notch.PanelBgMode">
    <value nick="theme" value="0"/>
    <value nick="transparent" value="1"/>
    <value nick="solid" value="2"/>
    <value nick="semi-transparent" value="3"/>
  </enum>
  <!-- BARU (refinement v2): warna teks/ikon, dipakai panel dan notch. -->
  <enum id="org.gnome.shell.extensions.dynamic-notch.FgMode">
    <value nick="auto" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="2"/>
  </enum>
  <!-- BARU (v4): mode layout expanded panel. -->
  <enum id="org.gnome.shell.extensions.dynamic-notch.LayoutMode">
    <value nick="full" value="0"/>
    <value nick="split" value="1"/>
    <value nick="custom" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.dynamic-notch" path="/org/gnome/shell/extensions/dynamic-notch/">
    <key name="notch-style" enum="org.gnome.shell.extensions.dynamic-notch.NotchStyle">
      <default>'apple'</default>
      <summary>Notch style: apple (mac mode) or pill</summary>
    </key>
    <key name="pill-position" enum="org.gnome.shell.extensions.dynamic-notch.Position">
      <default>'top'</default>
      <summary>Pill position: top, bottom, left, or right</summary>
    </key>
    <key name="notch-width" type="i">
      <range min="120" max="600"/>
      <default>200</default>
      <summary>Notch width in pixels</summary>
    </key>
    <key name="notch-height" type="i">
      <range min="30" max="100"/>
      <default>34</default>
      <summary>Notch height in pixels</summary>
    </key>
    <key name="notch-radius" type="i">
      <range min="0" max="40"/>
      <default>18</default>
      <summary>Notch corner radius in pixels</summary>
    </key>
    <key name="notch-bg" type="s">
      <default>'rgb(0,0,0)'</default>
      <summary>Notch background color (CSS color string)</summary>
    </key>
    <key name="transparent-panel" type="b">
      <default>false</default>
      <summary>Make the top panel transparent when no window is near it</summary>
    </key>
    <!-- BARU (refinement v2): background panel saat transparent-panel
         mati, atau background yang dipakai saat ada jendela menyentuh
         panel ketika transparent-panel menyala (solid/semi dipakai
         apa adanya, theme/transparent kembali ke tampilan stock). -->
    <key name="panel-bg-mode" enum="org.gnome.shell.extensions.dynamic-notch.PanelBgMode">
      <default>'theme'</default>
      <summary>Panel background: theme, transparent, solid, or semi-transparent</summary>
    </key>
    <!-- BARU (refinement v2) -->
    <key name="panel-color" type="s">
      <default>'rgba(24,24,32,0.72)'</default>
      <summary>Panel color for solid / semi-transparent modes (CSS rgb()/rgba() string; alpha is used by semi-transparent only)</summary>
    </key>
    <!-- BARU (refinement v2) -->
    <key name="panel-text-mode" enum="org.gnome.shell.extensions.dynamic-notch.FgMode">
      <default>'auto'</default>
      <summary>Panel text/icon color: auto (from the known panel color), light, or dark</summary>
    </key>
    <!-- BARU (refinement v2) -->
    <key name="notch-text-mode" enum="org.gnome.shell.extensions.dynamic-notch.FgMode">
      <default>'auto'</default>
      <summary>Notch text color: auto (from the notch background color), light, or dark</summary>
    </key>
    <!-- BARU (v4): layout system. enabled-widgets / widget-order /
         wide-widgets hanya berlaku di mode custom; full dan split
         adalah preset tetap. Id widget: actions, calendar,
         notifications, timer (area) dan notes, timer-summary,
         activity, clipboard, status, upcoming, shortcuts, focus,
         media (kartu kecil). -->
    <key name="layout-mode" enum="org.gnome.shell.extensions.dynamic-notch.LayoutMode">
      <default>'full'</default>
      <summary>Expanded layout mode: full, split, or custom</summary>
    </key>
    <key name="grid-gap" type="i">
      <range min="2" max="24"/>
      <default>8</default>
      <summary>Gap between grid cells in the expanded layout, in pixels</summary>
    </key>
    <key name="expanded-width" type="i">
      <range min="640" max="1600"/>
      <default>1024</default>
      <summary>Expanded island width in pixels (clamped to the monitor)</summary>
    </key>
    <key name="expanded-height" type="i">
      <range min="400" max="900"/>
      <default>560</default>
      <summary>Expanded island height in pixels (clamped to the monitor)</summary>
    </key>
    <key name="enabled-widgets" type="as">
      <default>['actions', 'calendar', 'notifications', 'timer', 'notes', 'timer-summary', 'activity', 'clipboard', 'status', 'upcoming', 'shortcuts', 'focus', 'media']</default>
      <summary>Widget ids shown in Custom layout mode</summary>
    </key>
    <key name="widget-order" type="as">
      <default>['notes', 'timer-summary', 'activity', 'clipboard', 'status', 'upcoming', 'shortcuts', 'focus', 'media']</default>
      <summary>Small-card order in Custom layout mode</summary>
    </key>
    <key name="wide-widgets" type="as">
      <default>[]</default>
      <summary>Small-card ids spanning two columns in Custom layout mode</summary>
    </key>
    <!-- BARU (v4): default editor timer, dipulihkan saat enable dan
         dipakai tombol Reset di strip timer. Bukan state countdown:
         timer yang sedang berjalan tidak selamat dari restart Shell. -->
    <key name="timer-title" type="s">
      <default>'Focus Timer'</default>
      <summary>Default timer title</summary>
    </key>
    <key name="timer-duration" type="i">
      <range min="1" max="359999"/>
      <default>1500</default>
      <summary>Default timer duration in seconds</summary>
    </key>
  </schema>
</schemalist>
